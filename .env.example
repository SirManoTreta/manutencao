# Referência: o app lê variáveis de ambiente do processo, não carrega .env sozinho.
# O padrão preserva data/app.db. Use outro diretório apenas em testes/desenvolvimento.
# MANUTENCAO_DATA_DIR=C:\caminho\ambiente-isolado
MOBILE_TOKEN_TTL_SECONDS=2592000
FCM_ENABLED=false
# JSON privado obtido no Firebase Console, fora do Git e fora do app Flutter.
# FIREBASE_CREDENTIALS=C:\secrets\firebase-service-account.json
# FIREBASE_PROJECT_ID=seu-projeto-firebase
